# ---------------------------------------------------------------------------
# 本地私有配置模板（不随作业提交）
#
# 用法：复制到【项目根目录】（与 pom.xml、启动.cmd 同级），改名为 application-local.yml，
#       再填自己的 Key。它只供本机开发用，已写进 .gitignore，不会被打进 jar，也不进提交包。
#
# 老师/评分者可以完全不建这个文件：
#   直接双击 启动.cmd 启动，登录后到网页「设置」页填写自己的 DeepSeek Key，保存即生效。
#
# 能力边界（不填 Key 时）：
#   可用：截图 OCR（不填百度 Key 时 provider=auto 会优先试本地 Tesseract，再退到 mock）、
#         单词本、查词、阅读、历史文章；
#   不可用：生成新文章、AI 查词（会提示"请先在设置页填写 DeepSeek Key"）。
#
# 不填百度 Key 时，provider=auto 的顺序是 Tesseract → mock，不会去调百度。
# ---------------------------------------------------------------------------
app:
  deepseek:
    # 去 https://platform.deepseek.com 注册 → 创建 API Key → 复制 sk- 开头那一串
    # 留空也行：改在网页右上角「设置」里填（网页填的优先级更高）
    api-key: ""

  ocr:
    # auto | baidu | tesseract | mock
    #   auto      百度有 Key 就用百度，否则用本地 tesseract，都没有就用 mock
    #   baidu     百度通用文字识别（高精度版），需要账号已实名
    #   tesseract 离线识别，不需要账号，单词卡截图更准（需 tessdata/eng.traineddata）
    #   mock      假数据，只用来演示界面
    provider: auto

    baidu:
      # 百度智能云 → 文字识别 → 应用管理 → 创建应用（勾选「通用文字识别（高精度版）」）
      app-id: ""
      api-key: ""
      secret-key: ""
      # true = 用高精度版（推荐），false = 标准版
      accurate: true

    # tesseract 的语言数据目录，相对项目根目录；文件是 tessdata/eng.traineddata
    tessdata: tessdata
    lang: eng

  article:
    # 生成文章的默认参数（页面上还能临时改）
    default-mode: review        # review | exam
    default-difficulty: C1      # B2 | C1 | C2
    default-paragraphs: 5
    default-questions: 5
    exam-word-limit: 15         # 真题模式最多用多少个目标词

# 如果你本机的 MySQL 不是默认口令，可以换一种方式覆盖：
# 设置环境变量 DB_USERNAME / DB_PASSWORD，或在 application.yml 里改默认值。
